# OpenAI 키는 메타코드에서 받은 것을 씁니다. 복사해서 .env 로 저장하고 OPENAI_API_KEY= 뒤에 붙입니다.
#   cp .env.example .env
# .env 는 커밋되지 않습니다. 값 뒤에 같은 줄로 주석을 달지 마세요(주석이 값으로 읽힙니다).

OPENAI_API_KEY=
# 답변 생성·파라미터 추출에 쓰는 모델과, 재작성·판정·Self-Query 에 쓰는 작은 모델
LLM_MODEL_MAIN=openai:gpt-5.4-mini
LLM_MODEL_SMALL=openai:gpt-5.4-nano

# ── 5회차 ──
# 재검색 상한. 실측 1 에서 1·2·3 으로 바꿔 가며 오거절률과 지연을 봅니다. 기본 2 (ADR-004)
# MAX_RETRIES=2

# ── 4회차 ──
# 리랭커. 기본은 BAAI/bge-reranker-v2-m3 (2.2GB). 메모리 8GB 노트북이면 작은 모델로 바꿉니다.
# RERANKER_MODEL=BAAI/bge-reranker-base
# 리랭커에 넣는 후보 수. 기본 10.
# RERANK_CANDIDATES=10

# ── 7회차 ──
# API 키. 클라이언트가 X-API-Key 헤더로 보냅니다. 수업은 기본값 그대로. 서비스에 낼 때 바꿉니다
API_KEY=change-me
# 호출 상한(접속 주소 기준). 수업에서 429 를 보려면 3/minute 로 바꾸고 서버를 다시 띄웁니다
RATE_LIMIT=30/minute
# Qdrant. 비워 두면 임베디드(파일) 모드. compose 를 띄운 뒤 호스트에서 서버를 쓰려면 http://localhost:6333
QDRANT_URL=
